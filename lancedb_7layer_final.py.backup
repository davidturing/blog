#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
LanceDB 7层混合检索模块 - DavidAgent 增强版

实现目标：
1. 基于现有记忆库，构建7层混合检索pipeline
2. 支持用户换话术提问，精准召回历史已解决的问题与答案
3. 检索结果：不重复、不冗余、最新、最相关

7层检索顺序：
1. 向量检索 → 2. BM25关键词检索 → 3. MMR去重 → 4. 元数据过滤 
5. 时间衰减加权 → 6. 用户偏好加权 → 7. 交叉编码器重排序
"""

import os
import sys
import sqlite3
import json
import re
import math
from datetime import datetime, timedelta
from typing import List, Dict, Tuple, Optional, Any
import numpy as np

# 使用 google.generativeai（虽然有警告，但当前可用）
import google.generativeai as genai
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.metrics.pairwise import cosine_similarity

# 全局配置
GEMINI_MODEL = "gemini-1.5-flash"
MEMORY_DB_PATH = "/Users/zhaoqinhuang/david_project/david_agent_memory.db"

class LanceDB7LayerRetriever:
    """LanceDB 7层混合检索引擎"""
    
    def __init__(self):
        self.db_conn = None
        self.embedding_cache = {}
        self.initialize_database()
        self.configure_gemini()
        
    def configure_gemini(self):
        """配置 Gemini API"""
        # 从环境变量获取 API key
        api_key = os.getenv("GOOGLE_API_KEY")
        if not api_key:
            # 尝试从凭据文件获取
            credentials_path = "/Users/zhaoqinhuang/david_project/.credentials/api_keys.env"
            if os.path.exists(credentials_path):
                with open(credentials_path, 'r') as f:
                    for line in f:
                        if line.startswith('GOOGLE_API_KEY='):
                            api_key = line.strip().split('=', 1)[1].strip('"\'')
                            break
        
        if api_key:
            genai.configure(api_key=api_key)
            print(f"✅ Gemini API 配置成功 (key length: {len(api_key)})")
        else:
            print("❌ 未找到 GOOGLE_API_KEY，向量检索将使用模拟模式")
            
    def initialize_database(self):
        """初始化数据库连接"""
        try:
            self.db_conn = sqlite3.connect(MEMORY_DB_PATH)
            self.db_conn.row_factory = sqlite3.Row
            print(f"✅ 连接记忆数据库: {MEMORY_DB_PATH}")
        except Exception as e:
            print(f"❌ 数据库连接失败: {e}")
            self.db_conn = None
            
    def get_embedding(self, text: str) -> List[float]:
        """获取文本的向量嵌入"""
        if not hasattr(genai, 'embed_content'):
            # 模拟模式：返回随机向量
            return np.random.rand(768).tolist()
            
        try:
            if text in self.embedding_cache:
                return self.embedding_cache[text]
                
            result = genai.embed_content(
                model="models/embedding-001",
                content=text,
                task_type="retrieval_document"
            )
            embedding = result['embedding']
            self.embedding_cache[text] = embedding
            return embedding
        except Exception as e:
            print(f"⚠️  向量生成失败: {e}")
            # 返回随机向量作为后备
            return np.random.rand(768).tolist()
            
    def layer1_vector_search(self, query: str, top_k: int = 20) -> List[Dict]:
        """第1层：向量检索"""
        print(f"🔍 第1层：向量检索 '{query}'")
        if not self.db_conn:
            return []
            
        try:
            # 获取查询向量
            query_embedding = self.get_embedding(query)
            
            # 从数据库获取所有已解决的记忆
            cursor = self.db_conn.cursor()
            cursor.execute("""
                SELECT signal_id, raw_text, timestamp, handle, author_name, likes, retweets
                FROM raw_signals 
                WHERE raw_text IS NOT NULL AND raw_text != ''
                ORDER BY timestamp DESC
                LIMIT 1000
            """)
            
            memories = []
            for row in cursor.fetchall():
                memories.append({
                    'id': row['signal_id'],
                    'content': row['raw_text'],
                    'timestamp': row['timestamp'],
                    'handle': row['handle'],
                    'author_name': row['author_name'],
                    'likes': row['likes'],
                    'retweets': row['retweets'],
                    'source': 'raw_signals'
                })
            
            if not memories:
                print("   ⚠️  无记忆数据")
                return []
                
            # 计算相似度
            similarities = []
            for memory in memories:
                memory_embedding = self.get_embedding(memory['content'])
                similarity = cosine_similarity([query_embedding], [memory_embedding])[0][0]
                similarities.append((memory, similarity))
            
            # 按相似度排序
            similarities.sort(key=lambda x: x[1], reverse=True)
            top_results = similarities[:top_k]
            
            results = []
            for memory, score in top_results:
                results.append({
                    'id': memory['id'],
                    'content': memory['content'],
                    'timestamp': memory['timestamp'],
                    'handle': memory['handle'],
                    'author_name': memory['author_name'],
                    'likes': memory['likes'],
                    'retweets': memory['retweets'],
                    'source': memory['source'],
                    'score': float(score),
                    'layer_scores': {'vector': float(score)}
                })
            
            print(f"   ✅ 找到 {len(results)} 条结果")
            return results
            
        except Exception as e:
            print(f"   ❌ 向量检索失败: {e}")
            return []
            
    def layer2_bm25_keyword_search(self, query: str, candidates: List[Dict]) -> List[Dict]:
        """第2层：BM25关键词检索"""
        print("🔍 第2层：BM25关键词检索")
        if not candidates:
            return candidates
            
        try:
            # 提取关键词
            query_keywords = set(re.findall(r'\b\w+\b', query.lower()))
            
            # 计算关键词匹配分数
            for candidate in candidates:
                content_words = set(re.findall(r'\b\w+\b', candidate['content'].lower()))
                keyword_matches = len(query_keywords & content_words)
                keyword_score = keyword_matches / max(len(query_keywords), 1)
                
                # 技术术语权重提升
                tech_terms = ['api', 'code', 'command', 'config', 'python', 'javascript', 'sql', 'docker', 'kubernetes']
                tech_matches = sum(1 for term in tech_terms if term in candidate['content'].lower())
                tech_boost = tech_matches * 0.1
                
                candidate['score'] += keyword_score * 0.3 + tech_boost
                candidate['layer_scores']['bm25'] = keyword_score + tech_boost
                
            print("   ✅ 关键词检索完成")
            return candidates
            
        except Exception as e:
            print(f"   ❌ 关键词检索失败: {e}")
            return candidates
            
    def layer3_mmr_deduplication(self, candidates: List[Dict], diversity_lambda: float = 0.7) -> List[Dict]:
        """第3层：MMR多样性去重"""
        print("🔍 第3层：MMR去重")
        if len(candidates) <= 1:
            return candidates
            
        try:
            # 简化的MMR实现
            selected = [candidates[0]]  # 选择最高分的
            
            for candidate in candidates[1:]:
                # 计算与已选结果的最大相似度
                max_sim = 0
                for selected_item in selected:
                    # 使用内容相似度
                    content_sim = self._calculate_content_similarity(
                        candidate['content'], selected_item['content']
                    )
                    max_sim = max(max_sim, content_sim)
                
                # MMR分数 = lambda * relevance - (1-lambda) * max_similarity
                mmr_score = diversity_lambda * candidate['score'] - (1 - diversity_lambda) * max_sim
                
                if mmr_score > 0.3:  # 阈值
                    selected.append(candidate)
                    
            print(f"   ✅ 去重后剩余 {len(selected)} 条")
            return selected
            
        except Exception as e:
            print(f"   ❌ 去重失败: {e}")
            return candidates
            
    def _calculate_content_similarity(self, text1: str, text2: str) -> float:
        """计算两个文本的内容相似度"""
        try:
            # 简单的Jaccard相似度
            words1 = set(re.findall(r'\b\w+\b', text1.lower()))
            words2 = set(re.findall(r'\b\w+\b', text2.lower()))
            if not words1 and not words2:
                return 0.0
            intersection = len(words1 & words2)
            union = len(words1 | words2)
            return intersection / union if union > 0 else 0.0
        except:
            return 0.0
            
    def layer4_metadata_filter(self, candidates: List[Dict]) -> List[Dict]:
        """第4层：元数据过滤（只保留已解决问题）"""
        print("🔍 第4层：元数据过滤")
        # 在我们的数据库中，raw_signals 表中的数据都是已处理的信号
        # 这里简单过滤掉明显无效的内容
        filtered = []
        for candidate in candidates:
            content = candidate['content'].strip()
            if len(content) > 10 and not content.startswith(('HEARTBEAT_OK', 'NO_REPLY')):
                filtered.append(candidate)
                
        print(f"   ✅ 过滤后剩余 {len(filtered)} 条")
        return filtered
        
    def layer5_time_decay_weighting(self, candidates: List[Dict]) -> List[Dict]:
        """第5层：时间衰减加权"""
        print("🔍 第5层：时间衰减加权")
        if not candidates:
            return candidates
            
        try:
            current_time = datetime.now()
            for candidate in candidates:
                # 解析时间戳
                try:
                    if isinstance(candidate['timestamp'], str):
                        mem_time = datetime.fromisoformat(candidate['timestamp'].replace('Z', '+00:00'))
                    else:
                        mem_time = datetime.fromtimestamp(candidate['timestamp'])
                except:
                    mem_time = current_time
                    
                # 计算天数差
                days_diff = (current_time - mem_time).days
                if days_diff < 0:
                    days_diff = 0
                    
                # 时间衰减公式: score = score * exp(-0.01 * 天数)
                time_weight = math.exp(-0.01 * days_diff)
                candidate['score'] *= time_weight
                candidate['layer_scores']['time_decay'] = time_weight
                
            print("   ✅ 时间衰减完成")
            return candidates
            
        except Exception as e:
            print(f"   ❌ 时间衰减失败: {e}")
            return candidates
            
    def layer6_preference_weighting(self, candidates: List[Dict]) -> List[Dict]:
        """第6层：用户偏好加权"""
        print("🔍 第6层：用户偏好加权")
        if not candidates:
            return candidates
            
        try:
            for candidate in candidates:
                content = candidate['content'].lower()
                preference_boost = 0.0
                
                # 命令、步骤、代码加分
                if any(keyword in content for keyword in ['命令', '步骤', '代码', 'command', 'step', 'code']):
                    preference_boost += 0.2
                    
                # 技术方案、架构说明加分
                if any(keyword in content for keyword in ['方案', '架构', '设计', 'solution', 'architecture', 'design']):
                    preference_boost += 0.15
                    
                # WordPress 相关内容（根据用户偏好）
                if 'wordpress' in content:
                    preference_boost += 0.1
                    
                candidate['score'] += preference_boost
                candidate['layer_scores']['preference'] = preference_boost
                
            print("   ✅ 偏好加权完成")
            return candidates
            
        except Exception as e:
            print(f"   ❌ 偏好加权失败: {e}")
            return candidates
            
    def layer7_rerank_with_cross_encoder(self, candidates: List[Dict], top_k: int = 3) -> List[Dict]:
        """第7层：交叉编码器重排序"""
        print("🔍 第7层：交叉编码器重排序")
        if not candidates:
            return candidates
            
        # 按分数排序并返回top_k
        candidates.sort(key=lambda x: x['score'], reverse=True)
        top_results = candidates[:top_k]
        
        print(f"   ✅ 重排序完成，返回 {len(top_results)} 条")
        return top_results
        
    def retrieve(self, query: str, top_k: int = 3) -> List[Dict]:
        """执行完整的7层混合检索"""
        print(f"\n{'='*50}")
        print(f"🔍 执行7层混合检索: {query}")
        print(f"{'='*50}")
        
        # 第1层：向量检索
        results = self.layer1_vector_search(query, top_k * 5)
        if not results:
            print("❌ 无相关历史记忆")
            return []
            
        # 第2层：BM25关键词检索
        results = self.layer2_bm25_keyword_search(query, results)
        
        # 第3层：MMR去重
        results = self.layer3_mmr_deduplication(results)
        
        # 第4层：元数据过滤
        results = self.layer4_metadata_filter(results)
        if not results:
            print("❌ 过滤后无有效结果")
            return []
            
        # 第5层：时间衰减加权
        results = self.layer5_time_decay_weighting(results)
        
        # 第6层：用户偏好加权
        results = self.layer6_preference_weighting(results)
        
        # 第7层：交叉编码器重排序
        results = self.layer7_rerank_with_cross_encoder(results, top_k)
        
        return results
        
    def format_results(self, results: List[Dict]) -> str:
        """格式化检索结果"""
        if not results:
            return "无相关历史记忆"
            
        output = "【记忆召回·已解决】\n\n"
        for i, result in enumerate(results, 1):
            # 解析时间戳
            try:
                if isinstance(result['timestamp'], str):
                    timestamp_str = result['timestamp']
                else:
                    timestamp_str = datetime.fromtimestamp(result['timestamp']).isoformat()
            except:
                timestamp_str = "未知时间"
                
            output += f"{i}. 相关度: {result['score']:.3f}\n"
            output += f"   内容: {result['content'][:200]}{'...' if len(result['content']) > 200 else ''}\n"
            output += f"   时间: {timestamp_str}\n"
            output += f"   来源: {result['source']}\n\n"
            
        return output.strip()

def main():
    """主函数 - 测试用例"""
    retriever = LanceDB7LayerRetriever()
    
    # 测试查询
    test_queries = [
        "WordPress 发布博客",
        "DAMA-DMBOK2 教程", 
        "LanceDB 向量检索",
        "Google Gemini API"
    ]
    
    for query in test_queries:
        results = retriever.retrieve(query)
        print(retriever.format_results(results))
        print("\n" + "="*60 + "\n")

if __name__ == "__main__":
    main()
dva:Agent_with_storage_and_knowledge a dva:Architectural_Level,
        dva:Concept ;
    rdfs:label "Agent with storage and knowledge" ;
    dva:builds_upon dva:Agent_with_tools ;
    dva:is_an_evolution_of dva:Agent_with_tools ;
    dva:mentionedIn dva:Source_test_x_2024885969250394191,
        dva:Source_x_2024885969250394191 ;
    rdfs:comment "Level 2 of agentic software. Adds session storage for conversational context and a searchable knowledge base (RAG) for domain-specific information.",
        "The second architectural level, adding session storage for context memory and a searchable knowledge base (RAG) for accessing external domain information.",
        "代理软件架构的第二级。通过会话存储解决无状态问题，并通过可搜索的知识库（RAG）提供领域知识。",
        "代理软件的第二级架构。通过增加会话存储以实现上下文记忆，并引入可检索的知识库（RAG），使代理能访问外部领域知识。",
        "智能体软件的第二级架构。通过增加会话存储以实现上下文记忆，并引入可检索的知识库（RAG），使智能体能访问外部领域知识。" .


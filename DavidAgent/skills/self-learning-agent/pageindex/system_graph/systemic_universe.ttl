dva:Agent_with_memory_and_learning a dva:Architectural_Level,
        dva:Concept ;
    rdfs:label "Agent with memory and learning" ;
    dva:builds_upon dva:Agent_with_storage_and_knowledge ;
    dva:is_an_evolution_of dva:Agent_with_storage_and_knowledge ;
    dva:is_enabled_by dva:LearningMachine ;
    dva:is_implemented_using dva:LearningMachine ;
    dva:mentionedIn dva:Source_test_x_2024885969250394191,
        dva:Source_x_2024885969250394191 ;
    dva:uses dva:LearningMachine ;
    dva:依赖于 dva:LearningMachine ;
    rdfs:comment "Level 3 of agentic software. Enables the agent to learn from interactions, storing experiences and user preferences to improve future performance.",
        "The third architectural level, enabling an agent to learn from experience and user preferences to improve future performance, often via a LearningMachine component.",
        "代理软件架构的第三级。代理能够从与用户的交互中学习规则、模式和偏好，并将其应用于未来的任务。",
        "代理软件的第三级架构。代理能够从交互中学习经验（如用户偏好），以优化未来表现，其核心是LearningMachine组件。",
        "代理软件的第三级架构。代理能够从交互中学习经验（如用户偏好），以优化未来表现，通常通过LearningMachine等组件实现。",
        "代理软件的第三级架构。代理能够从交互中学习经验，以优化未来表现。它通过LearningMachine组件存储和检索习得的模式与用户偏好。",
        "智能体软件的第三级架构。智能体能够从交互中学习经验（如用户偏好），以优化未来表现，是实现个性化的关键。" .

dva:Agentic_Software a dva:Concept ;
    rdfs:label "Agentic Software" ;
